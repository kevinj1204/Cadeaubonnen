# ============================================================
# Kopieer naar .env.local (lokaal) of zet in Vercel → Settings → Environment Variables
# ============================================================

# Database (Neon via Vercel Marketplace vult dit automatisch in)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Publieke adres van deze app (zonder / aan het eind) — voor links in e-mails
APP_URL=https://cadeaubon.thelightportraits.nl

# Backoffice-wachtwoord (minimaal 10 tekens, liefst een lange zin)
ADMIN_PASSWORD=

# Willekeurige geheime sleutel voor inlogsessies (minimaal 32 tekens)
SESSION_SECRET=

# Geheime sleutel voor de boekingsapp (minimaal 32 tekens). Dezelfde waarde
# zet je in Apps Script als CADEAUBON_API_KEY.
BOOKING_API_KEY=

# E-mail via SMTP (je mailbox bij goedkopewebhoster.nl). Leeg = geen e-mails.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@thelightportraits.nl
SMTP_PASS=
MAIL_FROM="The Light Portraits <info@thelightportraits.nl>"
# Optioneel: kopie van elke klantmail naar jezelf
MAIL_BCC=

# Optioneel: welke sites de bestelpagina in een iframe mogen tonen
# ALLOWED_FRAME_ANCESTORS='self' https://thelightportraits.nl https://*.thelightportraits.nl
# Optioneel: max. bestellingen per uur vanaf één IP-adres (standaard 10)
# ORDER_RATE_LIMIT=10
